<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    <AssemblyName>ParameterBatchManager</AssemblyName>
    <RootNamespace>ParameterBatchManager</RootNamespace>
    <!-- Suppress MSB3277 conflict warnings between net10.0 and Revit dependencies -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Post build event to deploy addin manifest and dll to Revit 2027 Addins folder -->
  <Target Name="DeployToRevit" AfterTargets="Build">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2027</RevitAddinsDir>
      <TargetAddinDir>$(RevitAddinsDir)\ParameterBatchManager</TargetAddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(TargetAddinDir)" />
    <MakeDir Directories="$(TargetAddinDir)\Resources" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TargetAddinDir)" ContinueOnError="true" Retries="0" />
    <Copy SourceFiles="$(ProjectDir)ParameterBatchManager.addin" DestinationFolder="$(RevitAddinsDir)" ContinueOnError="true" Retries="0" />
    <ItemGroup>
      <ResourceFiles Include="$(ProjectDir)Resources\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ResourceFiles)" DestinationFolder="$(TargetAddinDir)\Resources" ContinueOnError="true" Retries="0" />
    <Message Importance="High" Text="[ParameterBatchManager] Deployed add-in to $(RevitAddinsDir)" />
  </Target>

</Project>
